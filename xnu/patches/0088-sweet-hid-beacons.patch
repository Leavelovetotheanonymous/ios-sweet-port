 bool
 SweetHIDButtons::start(IOService *provider)
 {
+	/*
+	 * sweethid=0: do not publish anything and let the start queue move on.
+	 * The HID services are only needed by backboardd, long after the root
+	 * device is mounted, so dropping them is a safe way past a wedge here.
+	 * No beacon either: an empty beacon column is how a photo shows that the
+	 * driver was skipped on purpose rather than hung on entry.
+	 */
+	uint32_t hidOn = 1;
+	if (PE_parse_boot_argn("sweethid", &hidOn, sizeof(hidOn)) && hidOn == 0) {
+		return true;
+	}
+
+	sweet_beacon(0);
 	if (!IOHIDEventService::start(provider)) {
 		return false;
 	}
+	sweet_beacon(1);
 	if (PE_parse_boot_argn("sweethidtest", &fTestSecs, sizeof(fTestSecs)) && fTestSecs) {
 		fTest = IOTimerEventSource::timerEventSource(this, &SweetHIDButtons::testFired);
 		if (fTest && _hidWorkLoop->addEventSource(fTest) == kIOReturnSuccess) {
 			fTest->setTimeoutMS(fTestSecs * 1000);
 		}
 	}
+	sweet_beacon(2);
 	gSweetButtons = this;
 	registerService();
+	sweet_beacon(3);
 	IOLog("SWEET HID: buttons registered (test every %u s)\n", fTestSecs);
 	return true;
 }
 
