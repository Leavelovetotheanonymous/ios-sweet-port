diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 24f1abc..11b128b 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -613,6 +613,21 @@ sleh_synchronous(arm_context_t *context, uint32_t esr, vm_offset_t far)
 	uintptr_t saved_expected_fault_addr = 0;
 #endif /* CONFIG_XNUPOST */
 
+	/*
+	 * SWEET bring-up probe: print the real system registers next to the saved
+	 * state. If ELR/FAR disagree with pc/far the state is stale or garbage,
+	 * which is the whole question we are trying to answer here.
+	 */
+	if (!PSR64_IS_USER(get_saved_state_cpsr(state))) {
+		kprintf("SWEET SYNC: esr=%x class=%u far=%p pc=%p cpsr=%x | ELR=%p SPSR=%x FAR=%p\n",
+		    esr, (unsigned int)class, (void *)far,
+		    (void *)get_saved_state_pc(state),
+		    (unsigned int)get_saved_state_cpsr(state),
+		    (void *)__builtin_arm_rsr64("ELR_EL1"),
+		    (unsigned int)__builtin_arm_rsr64("SPSR_EL1"),
+		    (void *)__builtin_arm_rsr64("FAR_EL1"));
+	}
+
 	ASSERT_CONTEXT_SANITY(context);
 
 	task_vtimer_check(thread);
@@ -948,6 +963,12 @@ handle_uncategorized(arm_saved_state_t *state)
 			(void) ml_set_interrupts_enabled(interrupt_state);
 			return;
 		} else {
+			kprintf("SWEET UNDEF: pc=%p instr=%x cpsr=%x | ELR=%p SPSR=%x FAR=%p\n",
+			    (void *)get_saved_state_pc(state), instr,
+			    (unsigned int)get_saved_state_cpsr(state),
+			    (void *)__builtin_arm_rsr64("ELR_EL1"),
+			    (unsigned int)__builtin_arm_rsr64("SPSR_EL1"),
+			    (void *)__builtin_arm_rsr64("FAR_EL1"));
 			panic("Undefined kernel instruction: pc=%p instr=%x", (void*)get_saved_state_pc(state), instr);
 		}
 	}
