+extern "C" void sweet_beacon_repaint(void);
 
 /*
  * Milestone beacon: drivers call this with a step number as they get through
- * their start(), and the vsync timer repaints the lit cells every frame. Text
- * is drawn by the console and would rub the cells out, so they have to be
- * repainted; that also means the column only moves while the work loop runs.
+ * their start(), and the cell is painted right there and then. It used to be
+ * painted only from the vsync timer, which made the whole probe silent when
+ * the timer never ran -- exactly what the 13:06 photo showed.
  */
+extern "C" void
+sweet_beacon(uint32_t step);
+
 extern "C" void
 sweet_beacon(uint32_t step)
 {
 	if (step < SWEET_BEACON_CELLS && (step + 1) > sweet_hb_beacon) {
 		sweet_hb_beacon = step + 1;
 	}
+	sweet_beacon_repaint();
+}
+
+/* 0 means AppleCLCD::vsyncFired never ran a single time. */
+extern "C" uint32_t
+sweet_fb_vsync_ticks(void)
+{
+	return sweet_hb_ticks[0];
+}
+
+extern "C" uint32_t
+sweet_beacon_count(void)
+{
+	return sweet_hb_beacon;
+}
+
+static void
+sweet_fb_paint_beacons(volatile uint32_t *px, uint32_t strideWords, uint32_t w, uint32_t h);
+
+extern "C" void
+sweet_beacon_repaint(void)
+{
+	if (sweet_fb_base == 0) {
+		return;
+	}
+	sweet_fb_paint_beacons((volatile uint32_t *)sweet_fb_base,
+	    sweet_fb_rowBytes / 4, sweet_fb_width, sweet_fb_height);
 }
 
