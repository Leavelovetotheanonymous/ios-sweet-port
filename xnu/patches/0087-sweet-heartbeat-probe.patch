 {
 	AppleCLCD *fb = (AppleCLCD *)owner;
+
+	/* Before any lock: this must survive a wedged driver. */
+	sweet_fb_heartbeat(fb->fPixels, fb->fRowBytes, fb->fWidth, fb->fHeight, 0);
+
 	uint64_t now = mach_absolute_time();
 	uint64_t count = ++fb->fVsyncCount;
 	uint64_t values[6] = {
@@ -299,6 +342,9 @@
 void
 AppleCLCD::swap(const uint8_t *rec)
 {
+	/* Green heartbeat: proves a userland display server is submitting frames. */
+	sweet_fb_heartbeat(fPixels, fRowBytes, fWidth, fHeight, 1);
+
