+/*
+ * Heartbeat probe.
+ *
+ * Every observation channel we have goes through the console: kprintf takes
+ * the console lock and draws into the panel. If anything wedges that lock
+ * (or the thread that holds it), the screen freezes and looks exactly like a
+ * dead machine -- no panic, no reset, nothing. This draws straight into panel
+ * memory with no lock and no kprintf, so it keeps moving as long as the
+ * kernel is still scheduling.
+ *
+ *   top edge, red   -- incremented by the vsync timer (proof the work loop runs)
+ *   bottom edge, green -- incremented by swap() from userland (proof iOS is
+ *                      submitting frames, i.e. a display server is alive)
+ *
+ * The block sweeps left to right and wraps; a still block means that source
+ * stopped.
+ */
+static uint32_t sweet_hb_ticks[2];
+static uint32_t sweet_hb_beacon;        /* milestones lit, 0 = none */
+
+#define SWEET_BEACON_CELLS      32
+#define SWEET_BEACON_CELL       40
+#define SWEET_BEACON_PITCH      52
+
+/*
+ * Milestone beacon: drivers call this with a step number as they get through
+ * their start(), and the vsync timer repaints the lit cells every frame. Text
+ * is drawn by the console and would rub the cells out, so they have to be
+ * repainted; that also means the column only moves while the work loop runs.
+ */
+extern "C" void
+sweet_beacon(uint32_t step)
+{
+	if (step < SWEET_BEACON_CELLS && (step + 1) > sweet_hb_beacon) {
+		sweet_hb_beacon = step + 1;
+	}
+}
+
+static void
+sweet_fb_paint_beacons(volatile uint32_t *px, uint32_t strideWords, uint32_t w, uint32_t h)
+{
+	uint32_t cells = sweet_hb_beacon;
+	uint32_t x = (w > 160) ? (w - 120) : (w > 60 ? w - 50 : 0);
+
+	for (uint32_t i = 0; i < cells; i++) {
+		uint32_t y = 240 + i * SWEET_BEACON_PITCH;
+		if (y + SWEET_BEACON_CELL > h - 80) {
+			break;
+		}
+		for (uint32_t yy = y; yy < y + SWEET_BEACON_CELL; yy += 2) {
+			volatile uint32_t *line = px + (uint64_t)yy * strideWords;
+			for (uint32_t xx = x; xx < x + SWEET_BEACON_CELL; xx += 2) {
+				line[xx] = 0xffffffffu;
+			}
+		}
+	}
+}
+
+static void
+sweet_fb_heartbeat(uintptr_t pixels, uint32_t rowBytes, uint32_t w, uint32_t h, int which)
+{
+	if (pixels == 0 || w < 128 || h < 128) {
+		return;
+	}
+	uint32_t n = ++sweet_hb_ticks[which];
+	uint32_t span = w - 32;
+	uint32_t off = (which == 0) ? (n * 8) % span : (n * 32) % span;
+	uint32_t color = (which == 0) ? 0xffff0000u : 0xff00ff00u;
+	uint32_t y0 = (which == 0) ? 0u : (h - 32);
+
+	for (uint32_t y = y0; y < y0 + 32; y += 2) {
+		volatile uint32_t *line = (volatile uint32_t *)(pixels + (uint64_t)y * rowBytes);
+		for (uint32_t x = 0; x < w; x += 2) {
+			line[x] = (x >= off && x < off + 32) ? color : 0xff000000u;
+		}
+	}
+	if (which == 0) {
+		sweet_fb_paint_beacons((volatile uint32_t *)pixels, rowBytes / 4, w, h);
+	}
+}
+
 void
 AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 {
 	AppleCLCD *fb = (AppleCLCD *)owner;
+
+	/* Before any lock: this must survive a wedged driver. */
+	sweet_fb_heartbeat(fb->fPixels, fb->fRowBytes, fb->fWidth, fb->fHeight, 0);
+
 	uint64_t now = mach_absolute_time();
 	uint64_t count = ++fb->fVsyncCount;
 	uint64_t values[6] = {
@@ -299,6 +384,9 @@
 void
 AppleCLCD::swap(const uint8_t *rec)
 {
+	/* Green heartbeat: proves a userland display server is submitting frames. */
+	sweet_fb_heartbeat(fPixels, fRowBytes, fWidth, fHeight, 1);
+
 	IOLockLock(fLock);
 	memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
 	fDirty = true;
